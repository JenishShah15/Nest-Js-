{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "./build",

    "lib": ["ES2021"],
    "types": ["node"],

    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
